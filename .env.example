# Obbligatoria: https://console.groq.com/keys
GROQ_API_KEY=

# Facoltativa (riassunti .md): https://build.nvidia.com
NVIDIA_API_KEY=

# Facoltativo: modelli Whisper in ordine di preferenza, separati da virgola (se il primo fallisce si usa il successivo)
# WHISPER_MODEL=whisper-large-v3,whisper-large-v3-turbo

# Facoltativo: modelli NVIDIA per i riassunti, separati da virgola (il primo disponibile viene usato)
# NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b

# Facoltativo: altri fornitori al posto di Groq e NVIDIA (si scelgono da Impostazioni, più comodo).
# Trascrizione: groq (predefinito), openai, locale (server Whisper), pc (Whisper dentro il programma)
# Whisper su questo PC: l'audio non esce dal computer, nessuna chiave, blocchi da 30 s
# AI_TRASCRIZIONE=pc
# WHISPER_PC_MODELLO=large-v3-turbo   (oppure small: più veloce, meno RAM)
# AI_TRASCRIZIONE=openai
# OPENAI_API_KEY=
# MODELLO_TRASCRIZIONE_OPENAI=whisper-1
# Riassunti e chat: nvidia (predefinito), openai, gemini, claude, deepseek, mistral, openrouter, locale, personalizzato
# Per ognuno: URL_<FORNITORE> (endpoint, già compilato), la sua chiave e MODELLO_<FORNITORE>
# AI_TESTO=gemini
# GEMINI_API_KEY=
# MODELLO_GEMINI=gemini-2.5-flash
# AI locale (Ollama, LM Studio): niente esce dal PC, nessuna chiave
# AI_TESTO=locale
# LLM_LOCALE_URL=http://localhost:11434/v1
# LLM_LOCALE_MODELLO=qwen2.5:7b
# Qualsiasi servizio compatibile OpenAI
# AI_TESTO=personalizzato
# PERSONALIZZATO_URL=https://.../v1
# PERSONALIZZATO_API_KEY=
# MODELLO_PERSONALIZZATO=
