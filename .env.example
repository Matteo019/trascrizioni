# Obbligatoria: https://console.groq.com/keys
GROQ_API_KEY=

# Facoltativa (riassunti .md): https://build.nvidia.com
NVIDIA_API_KEY=

# Facoltativo: parte del nome delle cuffie su cui sentire la chiamata (es. AirPods).
# Se vuoto, lo script chiede all'avvio.
MONITOR_DEVICE=

