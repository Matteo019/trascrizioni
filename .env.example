# Obbligatoria: https://console.groq.com/keys
GROQ_API_KEY=

# Facoltativa (riassunti .md): https://build.nvidia.com
NVIDIA_API_KEY=

# Facoltativo: modelli Whisper in ordine di preferenza, separati da virgola (se il primo fallisce si usa il successivo)
# WHISPER_MODEL=whisper-large-v3,whisper-large-v3-turbo

# Facoltativo: modelli NVIDIA per i riassunti, separati da virgola (il primo disponibile viene usato)
# NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b

# Facoltativo: AI locale al posto di Groq e NVIDIA (si sceglie anche da Impostazioni).
# Serve un server sul PC con API compatibile OpenAI. Di base si usano le API key.
# AI_TRASCRIZIONE=locale
# WHISPER_LOCALE_URL=http://localhost:8000/v1
# WHISPER_LOCALE_MODELLO=Systran/faster-whisper-large-v3
# AI_TESTO=locale
# LLM_LOCALE_URL=http://localhost:11434/v1
# LLM_LOCALE_MODELLO=qwen2.5:7b
