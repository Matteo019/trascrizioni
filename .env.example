# Chiavi e modelli si impostano dalla dashboard → Impostazioni (più comodo):
#   1. le tue chiavi (anche più account dello stesso fornitore)
#   2. per Trascrizione, Riassunti e Chat: quale chiave e quale modello
# L'elenco e le scelte stanno in ai.json; i valori delle chiavi qui, come CHIAVE_<ID>=...
# Senza ai.json si usano queste due, come nelle versioni precedenti:

# Trascrizione: https://console.groq.com/keys
GROQ_API_KEY=

# Riassunti e chat: https://build.nvidia.com
NVIDIA_API_KEY=
